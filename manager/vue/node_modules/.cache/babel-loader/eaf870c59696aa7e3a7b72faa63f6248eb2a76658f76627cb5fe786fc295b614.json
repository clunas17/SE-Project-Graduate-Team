{"ast":null,"code":"import E from 'wangeditor';\nexport default {\n  name: \"Information\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      name: null,\n      recommend: null,\n      fromVisible: false,\n      editorVisible: false,\n      form: {},\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      rules: {},\n      ids: [],\n      viewData: null\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    viewDataInit(data) {\n      this.viewData = data;\n      this.editorVisible = true;\n    },\n    handleEdit(row) {\n      this.form = JSON.parse(JSON.stringify(row));\n      this.fromVisible = true;\n    },\n    save() {\n      this.$request({\n        url: this.form.id ? '/information/update' : '/information/add',\n        method: this.form.id ? 'PUT' : 'POST',\n        data: this.form\n      }).then(res => {\n        if (res.code === '200') {\n          this.$message.success('success');\n          this.load(1);\n          this.fromVisible = false;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/information/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          name: this.name,\n          recommend: this.recommend\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.recommend = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["E","name","data","tableData","pageNum","pageSize","total","recommend","fromVisible","editorVisible","form","user","JSON","parse","localStorage","getItem","rules","ids","viewData","created","load","methods","viewDataInit","handleEdit","row","stringify","save","$request","url","id","method","then","res","code","$message","success","error","msg","get","params","list","reset","handleCurrentChange"],"sources":["src/views/manager/Information.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"Search\" style=\"width: 200px\" v-model=\"name\"></el-input>\r\n      <el-select v-model=\"recommend\" placeholder=\"Recommended\" style=\"width: 200px; margin-left: 5px\">\r\n        <el-option label=\"Yes\" value=\"Yes\"></el-option>\r\n        <el-option label=\"No\" value=\"No\"></el-option>\r\n      </el-select>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">Search</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">Reset</el-button>\r\n    </div>\r\n\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column prop=\"img\" label=\"Cover\" width=\"100\">\r\n          <template v-slot=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-image style=\"width: 60px; height: 40px; border-radius: 10px\" v-if=\"scope.row.img\"\r\n                        :src=\"scope.row.img\" :preview-src-list=\"[scope.row.img]\"></el-image>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"name\" label=\"Name\" width=\"150\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"content\" label=\"Description\" width=\"100\">\r\n          <template v-slot=\"scope\">\r\n            <el-button type=\"success\" size=\"mini\" @click=\"viewDataInit(scope.row.content)\">view</el-button>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"userName\" label=\"Poster\"></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"Post Date\" width=\"100\"></el-table-column>\r\n        <el-table-column prop=\"file\" label=\"Link\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"score\" label=\"Score\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"recommend\" label=\"Recommended\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"Audit Status\"></el-table-column>\r\n        <el-table-column prop=\"descr\" label=\"Audit Comment\"></el-table-column>\r\n\r\n        <el-table-column label=\"Operation\" width=\"180\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <el-button plain type=\"primary\" @click=\"handleEdit(scope.row)\" size=\"mini\">Audit</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n            background\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pageNum\"\r\n            :page-sizes=\"[5, 10, 20]\"\r\n            :page-size=\"pageSize\"\r\n            layout=\"total, prev, pager, next\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n\r\n\r\n    <el-dialog title=\"Course Information\" :visible.sync=\"fromVisible\" width=\"55%\" :close-on-click-modal=\"false\" destroy-on-close>\r\n      <el-form label-width=\"100px\" style=\"padding-right: 50px\" :model=\"form\" :rules=\"rules\" ref=\"formRef\">\r\n        <el-form-item prop=\"file\" label=\"Link\">\r\n          <a :href=\"form.file\" target=\"_blank\">{{form.file}}</a>\r\n        </el-form-item>\r\n        <el-form-item prop=\"recommend\" label=\"Recommended\">\r\n          <el-select v-model=\"form.recommend\" placeholder=\"select\" style=\"width: 100%\">\r\n            <el-option label=\"Yes\" value=\"Yes\"></el-option>\r\n            <el-option label=\"No\" value=\"No\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item prop=\"status\" label=\"Status\">\r\n          <el-select v-model=\"form.status\" placeholder=\"select\" style=\"width: 100%\">\r\n            <el-option label=\"Processing\" value=\"Processing\"></el-option>\r\n            <el-option label=\"Approved\" value=\"Approved\"></el-option>\r\n            <el-option label=\"Rejected\" value=\"Rejected\"></el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <el-form-item prop=\"descr\" label=\"Comment\">\r\n          <el-input v-model=\"form.descr\" autocomplete=\"off\" placeholder=\"Comment\"></el-input>\r\n        </el-form-item>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"fromVisible = false\">Cancel</el-button>\r\n        <el-button type=\"primary\" @click=\"save\">Save</el-button>\r\n      </div>\r\n    </el-dialog>\r\n\r\n    <el-dialog title=\"Course Content\" :visible.sync=\"editorVisible\" width=\"50%\" :close-on-click-modal=\"false\" destroy-on-close>\r\n      <div v-html=\"viewData\" class=\"w-e-text w-e-text-container\"></div>\r\n    </el-dialog>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport E from 'wangeditor'\r\nexport default {\r\n  name: \"Information\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      name: null,\r\n      recommend: null,\r\n      fromVisible: false,\r\n      editorVisible: false,\r\n      form: {},\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      rules: {\r\n      },\r\n      ids: [],\r\n      viewData: null\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    viewDataInit(data) {\r\n      this.viewData = data\r\n      this.editorVisible = true\r\n    },\r\n    handleEdit(row) {\r\n      this.form = JSON.parse(JSON.stringify(row))\r\n      this.fromVisible = true\r\n    },\r\n    save() {\r\n      this.$request({\r\n        url: this.form.id ? '/information/update' : '/information/add',\r\n        method: this.form.id ? 'PUT' : 'POST',\r\n        data: this.form\r\n      }).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('success')\r\n          this.load(1)\r\n          this.fromVisible = false\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/information/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          name: this.name,\r\n          recommend: this.recommend,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.name = null\r\n      this.recommend = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"mappings":"AA8FA,OAAAA,CAAA;AACA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAL,IAAA;MACAM,SAAA;MACAC,WAAA;MACAC,aAAA;MACAC,IAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,KAAA,GACA;MACAC,GAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,aAAApB,IAAA;MACA,KAAAgB,QAAA,GAAAhB,IAAA;MACA,KAAAO,aAAA;IACA;IACAc,WAAAC,GAAA;MACA,KAAAd,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAa,SAAA,CAAAD,GAAA;MACA,KAAAhB,WAAA;IACA;IACAkB,KAAA;MACA,KAAAC,QAAA;QACAC,GAAA,OAAAlB,IAAA,CAAAmB,EAAA;QACAC,MAAA,OAAApB,IAAA,CAAAmB,EAAA;QACA3B,IAAA,OAAAQ;MACA,GAAAqB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAf,IAAA;UACA,KAAAZ,WAAA;QACA;UACA,KAAA0B,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IACAjB,KAAAhB,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAuB,QAAA,CAA