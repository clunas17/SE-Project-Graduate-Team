{"ast":null,"code":"export default {\n  data() {\n    return {};\n  },\n  mounted() {\n    this.loadRecommend();\n    this.loadRightData();\n  },\n  methods: {\n    loadRecommend() {\n      this.$request.get(\"/course/getRecommend\").then(res => {\n        if (res.code === '200') {\n          this.recommend = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    loadRightData() {\n      this.$request.get(\"/course/selectTop8\", {\n        params: {\n          recommend: 'No'\n        }\n      }).then(res => {\n        if (res.code === '200') {\n          this.rightData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","mounted","loadRecommend","loadRightData","methods","$request","get","then","res","code","recommend","$message","error","msg","params","rightData"],"sources":["src/views/front/Course.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe  @selection-change=\"handleSelectionChange\">\r\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"id\" label=\"id\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column label=\"Course cover\">\r\n          <template v-slot=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-image style=\"width: 60px; height: 40px; border-radius: 10px\" v-if=\"scope.row.img\"\r\n                        :src=\"scope.row.img\" :preview-src-list=\"[scope.row.img]\"></el-image>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"name\" label=\"Course name\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"content\" label=\"Description\" show-overflow-tooltip>\r\n       