\r\n\r\n  methods: {\r\n    loadRecommend(){\r\n      this.$request.get(\"/course/getRecommend\").then(res=>{\r\n        if(res.code === '200'){\r\n          this.recommend=res.data\r\n        }else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    loadRightData() {\r\n      this.$request.get(\"/course/selectTop8\",{\r\n        params:{\r\n          recommend:'No'\r\n        }\r\n      }).then(res=>{\r\n        if(res.code === '200'){\r\n          this.rightData=res.data\r\n        }else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n  }\r\n}\r\n\r\n</script>\r\n"],"mappings":"AA2DA;EAEAA,KAAA;IACA,QAEA;EACA;EACAC,QAAA;IACA,KAAAC,aAAA;IACA,KAAAC,aAAA;EAEA;EAEAC,OAAA;IACAF,cAAA;MACA,KAAAG,QAAA,CAAAC,GAAA,yBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,SAAA,GAAAF,GAAA,CAAAR,IAAA;QACA;UACA,KAAAW,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IACAV,cAAA;MACA,KAAAE,QAAA,CAAAC,GAAA;QACAQ,MAAA;UACAJ,SAAA;QACA;MACA,GAAAH,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAM,SAAA,GAAAP,GAAA,CAAAR,IAAA;QACA;UACA,KAAAW,QAAA,CAAAC,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}