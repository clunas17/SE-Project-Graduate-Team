{"ast":null,"code":"export default {\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      name: null,\n      level: null,\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}')\n    };\n  },\n  mounted() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/course/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          name: this.name,\n          level: this.level\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.level = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["data","tableData","pageNum","pageSize","total","name","level","user","JSON","parse","localStorage","getItem","mounted","load","methods","$request","get","params","then","res","list","reset","handleCurrentChange"],"sources":["src/views/front/Course.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <div style=\"width: 70%; margin:30px auto\">\r\n      <div class=\"search\" >\r\n        <el-input placeholder=\"Search\" style=\"width: 200px\" v-model=\"name\"></el-input>\r\n        <el-select v-model=\"level\" placeholder=\"Level\" style=\"width: 200px; margin-left: 10px\">\r\n          <el-option label=\"Beginner\" value=\"BEGINNER\"></el-option>\r\n          <el-option label=\"Intermediate\" value=\"INTERMEDIATE\"></el-option>\r\n          <el-option label=\"Advanced\" value=\"ADVANCED\"></el-option>\r\n        </el-select>\r\n        <el-select v-model=\"type\" placeholder=\"Type\" style=\"width: 200px; margin-left: 10px\">\r\n          <el-option label=\"Beginner\" value=\"BEGINNER\"></el-option>\r\n          <el-option label=\"Intermediate\" value=\"INTERMEDIATE\"></el-option>\r\n          <el-option label=\"Advanced\" value=\"ADVANCED\"></el-option>\r\n        </el-select>\r\n        <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">Search</el-button>\r\n        <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">Reset</el-button>\r\n      </div>\r\n      <div class=\"table\" >\r\n        <el-table :data=\"tableData\" stripe >\r\n\r\n          <el-table-column label=\"Course cover\" show-overflow-tooltip width=\"100\">\r\n            <template v-slot=\"scope\">\r\n              <div style=\"display: flex; align-items: center\">\r\n                <el-image style=\"width: 60px; height: 40px; border-radius: 5px; border: 1px solid #cccccc\" v-if=\"scope.row.img\"\r\n                          :src=\"scope.row.img\" :preview-src-list=\"[scope.row.img]\"></el-image>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"name\" label=\"Course name\" show-overflow-tooltip width=\"200\"></el-table-column>\r\n\r\n          <el-table-column prop=\"type\" label=\"Course type\">\r\n            <template v-slot=\"scope\">\r\n              <span v-if=\"scope.row.type === 'VIDEO'\" style=\"color: #FE7843\">Video Course</span>\r\n              <span v-else style=\"color: #2CBE56\">Text Course</span>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"price\" label=\"Price\">\r\n            <template v-slot=\"scope\">\r\n            <span v-if=\"scope.row.price === 0\">\r\n              <el-button type=\"success\" plain size=\"mini\">Free</el-button>\r\n            </span>\r\n              <span v-else style=\"color: #e10000; \">Score {{scope.row.price}}</span>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"level\" label=\"Level\"></el-table-column>\r\n          <el-table-column prop=\"time\" label=\"Post Date\"></el-table-column>\r\n\r\n\r\n\r\n\r\n        </el-table>\r\n\r\n        <div class=\"pagination\">\r\n          <el-pagination\r\n              background\r\n              @current-change=\"handleCurrentChange\"\r\n              :current-page=\"pageNum\"\r\n              :page-sizes=\"[5, 10, 20]\"\r\n              :page-size=\"pageSize\"\r\n              layout=\"total, prev, pager, next\"\r\n              :total=\"total\">\r\n          </el-pagination>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      name: null,\r\n      level: null,\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n\r\n    }\r\n  },\r\n  mounted() {\r\n    this.load(1)\r\n\r\n  },\r\n\r\n  methods: {\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/course/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          name: this.name,\r\n          level: this.level,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.name = null\r\n      this.level = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n  }\r\n}\r\n\r\n</script>\r\n"],"mappings":"AAyEA;EAEAA,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,IAAA;MACAC,KAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EAEA;EAEAC,OAAA;IACAD,KAAAX,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAa,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAf,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,IAAA,OAAAA,IAAA;UACAC,KAAA,OAAAA;QACA;MACA,GAAAY,IAAA,CAAAC,GAAA;QACA,KAAAlB,SAAA,GAAAkB,GAAA,CAAAnB,IAAA,EAAA