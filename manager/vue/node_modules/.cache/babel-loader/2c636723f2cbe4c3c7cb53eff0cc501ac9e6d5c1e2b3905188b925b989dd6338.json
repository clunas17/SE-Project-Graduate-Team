rseData.file }}</a></div>\r\n        </div>\r\n        <div v-else>\r\n          <span style=\"color: red; margin-right: 20px\">Unlock the content after payment</span>\r\n          <el-button type=\"warning\" size=\"mini\">Get the Course today!</el-button>\r\n        </div>\r\n      </div>\r\n      <div style=\"margin-top: 20px\">\r\n        <div style=\"font-size: 18px\">Course description</div>\r\n        <div style=\"margin-top: 10px\" v-html=\"courseData.content\" class=\"w-e-text w-e-text-container\"></div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport E from 'wangeditor'\r\nexport default {\r\n\r\n  data() {\r\n    let courseId = this.$route.query.id\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      courseId: courseId,\r\n      courseData: {}\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadCourse()\r\n  },\r\n\r\n  methods: {\r\n    loadCourse() {\r\n      this.$request.get('/course/selectById/' + this.courseId).then(res => {\r\n        if (res.code === '200') {\r\n          this.courseData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/deep/.el-form-item__label {\r\n  font-weight: bold;\r\n}\r\n/deep/.el-upload {\r\n  border-radius: 50%;\r\n}\r\n/deep/.avatar-uploader .el-upload {\r\n  border: 1px dashed #d9d9d9;\r\n  cursor: pointer;\r\n  position: relative;\r\n  overflow: hidden;\r\n  border-radius: 50%;\r\n}\r\n/deep/.avatar-uploader .el-upload:hover {\r\n  border-color: #409EFF;\r\n}\r\n.avatar-uploader-icon {\r\n  font-size: 28px;\r\n  color: #8c939d;\r\n  width: 120px;\r\n  height: 120px;\r\n  line-height: 120px;\r\n  text-align: center;\r\n  border-radius: 50%;\r\n}\r\n.avatar {\r\n  width: 120px;\r\n  height: 120px;\r\n  display: block;\r\n  border-radius: 50%;\r\n}\r\n</style>"],"mappings":"AAgCA,OAAAA,CAAA;AACA;EAEAC,KAAA;IACA,IAAAC,QAAA,QAAAC,MAAA,CAAAC,KAAA,CAAA