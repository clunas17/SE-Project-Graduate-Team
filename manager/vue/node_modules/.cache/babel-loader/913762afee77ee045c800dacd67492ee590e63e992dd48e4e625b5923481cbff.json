{"ast":null,"code":"export default {\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 5,\n      total: 0,\n      name: null,\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}')\n    };\n  },\n  mounted() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/course/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          name: this.name,\n          recommend: this.recommend\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.name = null;\n      this.recommend = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["data","tableData","pageNum","pageSize","total","name","user","JSON","parse","localStorage","getItem","mounted","load","methods","$request","get","params","recommend","then","res","list","reset","handleCurrentChange"],"sources":["src/views/front/Course.vue"],"sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <div class=\"table\" style=\"width: 70%; margin:30px auto\">\r\n      <el-table :data=\"tableData\" stripe >\r\n\r\n        <el-table-column label=\"Course cover\">\r\n          <template v-slot=\"scope\">\r\n            <div style=\"display: flex; align-items: center\">\r\n              <el-image style=\"width: 60px; height: 40px; border-radius: 10px\" v-if=\"scope.row.img\"\r\n                        :src=\"scope.row.img\" :preview-src-list=\"[scope.row.img]\"></el-image>\r\n            </div>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"name\" label=\"Course name\" show-overflow-tooltip></el-table-column>\r\n\r\n        <el-table-column prop=\"type\" label=\"Course type\">\r\n          <template v-slot=\"scope\">\r\n            <span v-if=\"scope.row.type === 'VIDEO'\" style=\"color: #FE7843\">Video Course</span>\r\n            <span v-else style=\"color: #2CBE56\">Text Course</span>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"price\" label=\"Price\"></el-table-column>\r\n        <el-table-column prop=\"video\" label=\"Video\" show-overflow-tooltip>\r\n          <template v-slot=\"scope\" >\r\n            <el-button type=\"warning\" plain size=\"mini\" @click=\"down(scope.row.video)\" v-if =\"scope.row.type === 'VIDEO'\">Download</el-button>\r\n          </template>\r\n        </el-table-column>\r\n        <el-table-column prop=\"file\" label=\"Profile\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"recommend\" label=\"Recommended\"></el-table-column>\r\n        <el-table-column prop=\"level\" label=\"Level\"></el-table-column>\r\n\r\n\r\n\r\n        <el-table-column label=\"operation\" width=\"180\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <el-button plain type=\"primary\" @click=\"handleEdit(scope.row)\" size=\"mini\">edit</el-button>\r\n            <el-button plain type=\"danger\" size=\"mini\" @click=del(scope.row.id)>delete</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n            background\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pageNum\"\r\n            :page-sizes=\"[5, 10, 20]\"\r\n            :page-size=\"pageSize\"\r\n            layout=\"total, prev, pager, next\"\r\n            :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 5,\r\n      total: 0,\r\n      name: null,\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n\r\n    }\r\n  },\r\n  mounted() {\r\n    this.load(1)\r\n\r\n  },\r\n\r\n  methods: {\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/course/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          name: this.name,\r\n          recommend: this.recommend,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.name = null\r\n      this.recommend = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n  }\r\n}\r\n\r\n</script>\r\n"],"mappings":"AA2DA;EAEAA,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,IAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EAEA;EAEAC,OAAA;IACAD,KAAAV,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAY,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAd,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,IAAA,OAAAA,IAAA;UACAY,SAAA,OAAAA;QACA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,KAAAlB,SAAA,GAAAkB,GAAA,CAAAnB,IAAA,EAAAoB,IAAA;QACA,KAAAhB,KAAA,GAAAe,GAAA,CAAAnB,IAAA,EAAAI,KAAA;MACA;IACA;IACAiB,MAAA;MACA,KAAAhB,IAAA;MACA,KAAAY,SAAA;MACA,KAAAL,IAAA;IACA;IACAU,oBAAApB,OAAA;MACA,KAAAU,IAAA,CAAAV,OAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}